# ─── Database (Neon Postgres via Vercel Marketplace) ────────────────────────
# Pooled connection for Prisma queries
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection for Prisma Migrate (bypasses PgBouncer)
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Auth.js / NextAuth ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"

# Public URL of the app (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── Bootstrap Admin Account ────────────────────────────────────────────────
# Used only by prisma/seed.ts to create the first admin user
ADMIN_EMAIL="admin@teaplanet.com"
# Generate with: node -e "require('bcryptjs').hash('yourPassword',12).then(console.log)"
ADMIN_PASSWORD_HASH="$2b$12$replace-with-bcrypt-hash"
ADMIN_NAME="Tea Planet Admin"
