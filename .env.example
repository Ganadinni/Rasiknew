# ─── Database (Neon Postgres via Vercel Marketplace) ─────────────────────────
# Pooled connection — used for all Prisma queries at runtime
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection — used by Prisma Migrate (bypasses PgBouncer)
PRISMA_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── Auth.js / NextAuth ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-generated-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Admin Bootstrap ─────────────────────────────────────────────────────────
# Used by prisma/seed.ts to create the first admin user
ADMIN_EMAIL="admin@teaplanet.com"
ADMIN_PASS="your-plain-password"          # hashed automatically by seed
ADMIN_NAME="Tea Planet Admin"

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Set to "openai" or "anthropic"
AI_PROVIDER="anthropic"

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=""

# Anthropic (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=""

# Optional: override default model
# OpenAI default: gpt-4o
# Anthropic default: claude-sonnet-4-6
AI_MODEL=""
