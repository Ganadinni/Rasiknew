generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("PRISMA_DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RequestStatus {
  NEW
  REVIEWED
  CLOSED
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipes      Recipe[]
  chatSessions ChatSession[]

  @@map("users")
}

// ─── Product Catalog ──────────────────────────────────────────────────────────

model Product {
  id                      String   @id @default(cuid())
  sku                     String   @unique
  name                    String
  category                String?
  subcategory             String?
  applicationType         String?
  catalogSource           String?
  price                   Decimal? @db.Decimal(10, 2)
  unit                    String?
  packSize                String?
  distributorAvailability Boolean  @default(true)
  websiteUrl              String?
  genericIngredients      String?
  notes                   String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  recipeIngredients RecipeIngredient[]

  @@map("products")
}

// ─── Recipes ──────────────────────────────────────────────────────────────────

model Recipe {
  id          String   @id @default(cuid())
  title       String
  style       String?
  application String?
  portion     String?
  contentJson Json

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients RecipeIngredient[]

  @@map("recipes")
}

model RecipeIngredient {
  id             String  @id @default(cuid())
  recipeId       String
  recipe         Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  ingredientName String
  sku            String?
  dosage         String?
  remarks        String?

  @@map("recipe_ingredients")
}

// ─── AI Prompt Rules ──────────────────────────────────────────────────────────

model PromptRule {
  id        String   @id @default(cuid())
  title     String
  ruleText  String
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("prompt_rules")
}

// ─── Chat ─────────────────────────────────────────────────────────────────────

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  createdAt DateTime    @default(now())

  @@map("chat_messages")
}

// ─── Customer Requests ────────────────────────────────────────────────────────

model CustomerRequest {
  id                    String        @id @default(cuid())
  customerName          String?
  requestText           String
  mappedApplicationType String?
  suggestedSkuJson      Json?
  whatsappText          String?
  status                RequestStatus @default(NEW)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("customer_requests")
}
